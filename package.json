{
  "name": "violetwire",
  "version": "0.3.4-alpha.3",
  "private": true,
  "description": "A native-feeling Windows Twitch viewer",
  "author": "VioletWire contributors",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucaboox/VioletWire.git"
  },
  "homepage": "https://github.com/lucaboox/VioletWire#readme",
  "bugs": {
    "url": "https://github.com/lucaboox/VioletWire/issues"
  },
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "prepare:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-native-runtime.ps1",
    "build:texture-player": "node-gyp rebuild --directory native/texture-player --arch=x64",
    "package:win": "npm run prepare:native && npm run build:texture-player && npm run build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "release:win": "npm run prepare:native && npm run build:texture-player && npm run build && electron-builder --config electron-builder.config.cjs --win --publish never",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.check.json --pretty false"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "electron-updater": "6.8.9",
    "emoji-picker-element": "^1.29.1",
    "hls.js": "^1.6.15",
    "lucide-react": "1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "7zip-bin": "5.2.0",
    "electron": "43.1.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "node-addon-api": "8.9.0",
    "node-gyp": "12.4.0",
    "prettier": "3.9.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  }
}
